# Google Gemini — used to parse prompts, write the land-change narrative,
# and answer the test box under the home tiles.
# The value below is a placeholder. The app sends it as a real key.
# Replace it with a key from Google AI Studio when you want live replies.
GEMINI_API_KEY=placeholder-gemini-api-key

# Adapter switch. true = simulated imagery. false = POST to your model.
USE_MOCK_MODEL=true

# Your finished model. Used only when USE_MOCK_MODEL=false.
ML_MODEL_ENDPOINT_URL=http://localhost:8000/predict

# Land model. Both accept a PNG form upload under the key "file".
ML_PREDICTION_IMAGE_URL=http://1.52.76.251:63480/predictionImage
ML_PREDICTION_DATA_URL=http://1.52.76.251:63480/predictionData

# Optional bearer token sent as Authorization: Bearer <key>
ML_MODEL_API_KEY=
