# Google Gemini — used to parse prompts and write the land-change narrative.
# Leave blank to run with the local parser and a data-driven narrative.
GEMINI_API_KEY=

# Adapter switch. true = simulated imagery. false = POST to your model.
USE_MOCK_MODEL=true

# Your finished model. Used only when USE_MOCK_MODEL=false.
ML_MODEL_ENDPOINT_URL=http://localhost:8000/predict

# Optional bearer token sent as Authorization: Bearer <key>
ML_MODEL_API_KEY=
